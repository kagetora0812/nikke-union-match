/* UNION MATCH: new UI only. Never change body, scrolling shell, modal, or page modes. */
.um-notification-bell{position:relative;display:flex;align-items:center;justify-content:flex-end;flex:0 0 auto;box-sizing:border-box;width:var(--um-bell-box-height,40px);height:var(--um-bell-box-height,40px);margin-left:auto;margin-right:8px;padding:0;background:transparent;border:0;color:#fff;cursor:pointer}.um-notification-bell svg{display:block;height:100%;width:auto;aspect-ratio:1;overflow:visible}.um-bell-light{position:absolute;right:-3px;top:-3px;width:8px;height:8px;border-radius:50%;background:#858585;border:1px solid #14161a}.um-notification-bell[data-status="on"] .um-bell-light{background:#42b8ff}
/* Respect each page's current header layout; the bell's right edge occupies the old BOT button right edge. */
/* TOP keeps the exact former BOT-button right/top/bottom alignment. */
.video-topbar .um-notification-bell{position:absolute;top:50%;right:72px;transform:translateY(-50%);margin:0;--um-bell-box-height:40px}
@media (min-width:601px) and (max-width:1024px){.video-topbar .um-notification-bell{right:66px;--um-bell-box-height:32px}}
@media(max-width:600px){.video-topbar .um-notification-bell{right:58px;--um-bell-box-height:24px}}
@media(max-width:360px){.video-topbar .um-notification-bell{right:54px;--um-bell-box-height:22px}}
.site-menu-drawer>a,.site-menu-drawer>button:not(.site-menu-head button){font-family:"Noto Sans JP",sans-serif;font-size:14px;font-weight:500}.site-menu-drawer>.um-notification-menu-entry{display:flex;align-items:center;min-height:52px;width:100%;padding:0 14px;background:transparent;color:#fff;border:0;border-bottom:1px solid rgba(255,255,255,.10);text-align:left;cursor:pointer}
/* Reuse existing footer visibility + breakpoint rules; style only the four replacement entries. */
.bottom-nav>.um-footer-item,.subpage-bottom-nav>.um-footer-item,.union-list-bottom-nav>.um-footer-item{box-sizing:border-box;min-width:0;display:flex;align-items:center;justify-content:center;flex-direction:column;gap:3px;text-align:center;text-decoration:none;background:transparent;color:#fff;border:0;cursor:pointer;font:500 10px/1.15 "Noto Sans JP",sans-serif}
.bottom-nav>.um-footer-item svg,.subpage-bottom-nav>.um-footer-item svg,.union-list-bottom-nav>.um-footer-item svg{width:21px;height:21px;flex:none}.bottom-nav>.um-footer-item>span,.subpage-bottom-nav>.um-footer-item>span,.union-list-bottom-nav>.um-footer-item>span{display:block;font:500 10px/1.15 "Noto Sans JP",sans-serif}
/* Retain the original 1366px threshold and all special page-mode display conditions. */
@media(max-width:1366px){.subpage-bottom-nav,.union-list-bottom-nav{grid-template-columns:repeat(4,minmax(0,1fr))!important}}
@media(max-width:1366px){.bottom-nav>.um-footer-item{flex:1;max-width:none}}
#manageBackBtn .um-back-label{font:500 12px/1.2 "Noto Sans JP",sans-serif;margin-left:5px}
#manageMembershipConfirmedNotice .um-confirm-date,#manageMembershipConfirmedNotice .um-confirm-note{display:block;white-space:normal}#manageMembershipConfirmedNotice .um-confirm-note{margin-top:4px;color:#53616c;font-size:11px}
.um-notification-dialog{position:fixed;inset:0;z-index:4000;display:none;align-items:center;justify-content:center;padding:16px;background:rgba(0,0,0,.55)}.um-notification-dialog[data-open="true"]{display:flex}.um-notification-panel{box-sizing:border-box;width:min(440px,100%);max-height:88dvh;overflow:auto;background:#fff;color:#222;padding:24px;border:1px solid #ddd;border-radius:12px;font-family:"Noto Sans JP",sans-serif}.um-notification-panel h2{font-size:23px;margin:0}.um-notification-panel .um-subtitle{font-size:12px;color:#777;margin:4px 0 16px}.um-notification-panel .um-row{display:flex;justify-content:space-between;align-items:center;gap:14px;min-height:60px;padding:12px 0;border-bottom:1px solid #e6e8eb;font-size:13px;font-weight:500}.um-notification-panel input[type=checkbox]{width:20px;height:20px;accent-color:#138dc9}.um-notification-panel .um-pass-wrap{padding:12px 0}.um-notification-panel .um-pass-wrap[hidden]{display:none}.um-notification-panel input[type=password]{width:100%;padding:12px;border:1px solid #ccc}.um-notification-panel .um-save{width:100%;margin-top:14px;padding:12px;background:#202328;color:#fff;border:0;cursor:pointer}.um-notification-panel .um-close{float:right;border:0;background:transparent;color:#222;font-size:24px;cursor:pointer}.um-notification-panel .um-status,.um-notification-panel .um-hint{font-size:11px;line-height:1.8;margin-top:12px;color:#656970}
